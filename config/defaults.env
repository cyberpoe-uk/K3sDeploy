# Storage safety defaults. Adjust deliberately for your hardware/workloads.
LONGHORN_ROOT_MIN_GIB=120
LONGHORN_ROOT_MIN_AVAILABLE_GIB=60
LONGHORN_DATA_MIN_GIB=20
LONGHORN_DATA_RECOMMENDED_GIB=100
OS_DISK_MIN_ROOT_PERCENT=30
OS_ROOT_MIN_AVAILABLE_GIB=15
LONGHORN_ROOT_RESERVED_PERCENT=30
LONGHORN_MIN_AVAILABLE_PERCENT=25
LONGHORN_OVERPROVISIONING_PERCENT=100
LONGHORN_DEFAULT_REPLICAS=3
MIN_RECOMMENDED_CPU=4
MIN_RECOMMENDED_RAM_GIB=4

# Embedded-etcd protection. K3s runs this schedule independently on every
# manager and keeps the snapshots in that manager's K3s data directory.
ETCD_SNAPSHOT_SCHEDULE_CRON='0 */12 * * *'
ETCD_SNAPSHOT_RETENTION=5
ETCD_MILESTONE_RETENTION=1
ETCD_SNAPSHOT_COMPRESS=true
